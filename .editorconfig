# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,toml,wgsl}]
indent_style = space
indent_size = 4

[*.{js,css,html,json,yml,yaml,md}]
indent_style = space
indent_size = 2

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

# Kept exactly as published by the Free Software Foundation.
[LICENSE]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
